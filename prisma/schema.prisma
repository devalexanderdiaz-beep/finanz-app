generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Language {
  es
  en
}

enum Frequency {
  DIARIO
  SEMANAL
  QUINCENAL
  MENSUAL
  ANUAL
}

enum weekDay {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum monthDay {
  ENERO
  FEBRERO
  MARZO
  ABRIL
  MAYO
  JUNIO
  JULIO
  AGOSTO
  SEPTIEMBRE
  OCTUBRE
  NOVIEMBRE
  DICIEMBRE
}

// Models
model Role {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(50)
  description String @db.VarChar(255)
  
  users User[]

  @@map("role")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(50)
  firstSurname String @db.VarChar(50) @map("first_surname")
  secondSurname String @db.VarChar(50) @map("second_surname")
  email String @unique @db.VarChar(150)
  username String @unique @db.VarChar(10)
  password String @db.VarChar(255)
  language Language @default(es)
  darkMode Boolean @default(true) @map("dark_mode")
  notifyDebt Boolean @default(true) @map("notify_debt")
  notifyRecurringTransaction Boolean @default(true) @map("notify_recurring_transaction")
  avatar String @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roleId Int @map("id_role")
  role Role @relation(fields: [roleId], references: [id])

  categories Category[]
  paymentReminders PaymentReminder[]
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@map("user")
}

model Category {
  id Int @id @default(autoincrement())
  name String @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")
  icon String @db.VarChar(50)
  color String @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userId String @db.Uuid @map("id_user")
  user User @relation(fields: [userId], references: [id])

  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@map("category")
}

model PaymentReminder {
  id Int @id @default(autoincrement())
  description String @db.VarChar(255)
  amount Decimal @db.Decimal(16, 2)
  maturity DateTime
  isPaid Boolean @default(false) @map("is_paid")
  isActive Boolean @default(true) @map("is_active")
  notified Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userId String @db.Uuid @map("id_user")
  user User @relation(fields: [userId], references: [id])

  @@map("payment_reminder")
}

enum TransactionType {
  Ingreso
  Gasto
}

model Transaction {
  id Int @id @default(autoincrement())
  description String @db.VarChar(255)
  amount Decimal @db.Decimal(16, 2)
  type TransactionType
  date DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userId String @db.Uuid @map("id_user")
  user User @relation(fields: [userId], references: [id])
  categoryId Int @map("id_category")
  category Category @relation(fields: [categoryId], references: [id])

  @@map("transaction")
}

model RecurringTransaction {
  id Int @id @default(autoincrement())
  description String @db.VarChar(255)
  amount Decimal @db.Decimal(16, 2)
  type TransactionType
  frequency Frequency
  weekDay weekDay? @map("week_day")
  executionDay Int? @db.SmallInt @map("execution_day")
  monthDay monthDay? @map("month_day")
  lastExecution DateTime? @map("last_execution")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userId String @db.Uuid @map("id_user")
  user User @relation(fields: [userId], references: [id])
  categoryId Int @map("id_category")
  category Category @relation(fields: [categoryId], references: [id])

  @@map("recurring_transaction")
}